{
  //
  // === BUILTIN ===
  //
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Monaco, menlo, Consolas",
  "editor.fontSize": 13,
  "editor.tabSize": 2,
  "editor.lineHeight": 1.618,
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,
  "editor.semanticHighlighting.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.inlineSuggest.enabled": false,
  "editor.hover.delay": 600,
  "window.zoomLevel": -0.65,
  "workbench.activityBar.compact": true,
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "workbench.startupEditor": "none",
  "workbench.enableExperiments": false,
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "window.restoreWindows": "none",
  "window.density.editorTabHeight": "compact",
  "window.density.layout": "compact",
  "update.mode": "manual",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.minimumContrastRatio": 1,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.jj": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/*.min.js": true
  },
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "[python]": {
    "editor.tabSize": 4
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "workbench.colorCustomizations": {
    "[Dark 2026]": {
      "editorHoverWidget.border": "#79c0ff",
    },
    "[Light 2026]": {
      "editorHoverWidget.border": "#0550ae",
    },
    "[Catppuccin Mocha]": {
      "editorHoverWidget.border": "#89b4fa",
    },
  },
  // 
  // === PLUGIN: VSCodeVim ===
  //
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.showcmd": false,
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 1000,
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "<leader>"
      ],
      "commands": [
        "workbench.action.showCommands"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "after": [
        "<C-w>",
        "h"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "after": [
        "<C-w>",
        "j"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "after": [
        "<C-w>",
        "k"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "after": [
        "<C-w>",
        "l"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "b"
      ],
      "commands": [
        "workbench.action.showAllEditorsByMostRecentlyUsed"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "n"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "o"
      ],
      "commands": [
        "workbench.action.gotoSymbol"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "O"
      ],
      "commands": [
        "workbench.action.showAllSymbols"
      ]
    },
    {
      "before": [
        "<leader>",
        "f",
        "w"
      ],
      "commands": [
        "workbench.action.findInFiles"
      ]
    },
    {
      "before": [
        "<leader>",
        "t",
        "n"
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    }
  ],
  //
  // === PLUGIN: Jupyter ===
  //
  "notebook.cellFocusIndicator": "border",
  "notebook.compactView": false,
  "notebook.lineNumbers": "on",
  "notebook.insertToolbarLocation": "notebookToolbar",
  "notebook.showCellStatusBar": "visibleAfterExecute",
  "notebook.output.scrolling": true,
}